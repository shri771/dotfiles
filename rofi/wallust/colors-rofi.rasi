 /* wallust template - colors-rofi */

* {
active-background: #0C151E;
active-foreground: #EBE2E3;
normal-background: #131416;
normal-foreground: #EBE2E3;
urgent-background: #685055;
urgent-foreground: #EBE2E3;

alternate-active-background: #4E3C40;
alternate-active-foreground: #EBE2E3;
alternate-normal-background: #131416;
alternate-normal-foreground: #EBE2E3;
alternate-urgent-background: #131416;
alternate-urgent-foreground: #EBE2E3;

selected-active-background: #0C151E;
selected-active-foreground: #EBE2E3;
selected-normal-background: #DACDCF;
selected-normal-foreground: #EBE2E3;
selected-urgent-background: #685055;
selected-urgent-foreground: #EBE2E3;

background-color: #131416;
background: rgba(0,0,0,0.7);
foreground: #DACDCF;
border-color: #0C151E;
}

