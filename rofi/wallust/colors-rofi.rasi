 /* wallust template - colors-rofi */

* {
active-background: #7E6683;
active-foreground: #F0DBEB;
normal-background: #2D2A2D;
normal-foreground: #F0DBEB;
urgent-background: #D599C7;
urgent-foreground: #F0DBEB;

alternate-active-background: #A07395;
alternate-active-foreground: #F0DBEB;
alternate-normal-background: #2D2A2D;
alternate-normal-foreground: #F0DBEB;
alternate-urgent-background: #2D2A2D;
alternate-urgent-foreground: #F0DBEB;

selected-active-background: #7E6683;
selected-active-foreground: #F0DBEB;
selected-normal-background: #E2C4DB;
selected-normal-foreground: #F0DBEB;
selected-urgent-background: #D599C7;
selected-urgent-foreground: #F0DBEB;

background-color: #2D2A2D;
background: rgba(0,0,0,0.7);
foreground: #E2C4DB;
border-color: #7E6683;
}

