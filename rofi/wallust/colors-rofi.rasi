 /* wallust template - colors-rofi */

* {
active-background: #3C364E;
active-foreground: #EEE7EF;
normal-background: #252428;
normal-foreground: #EEE7EF;
urgent-background: #847890;
urgent-foreground: #EEE7EF;

alternate-active-background: #938697;
alternate-active-foreground: #EEE7EF;
alternate-normal-background: #252428;
alternate-normal-foreground: #EEE7EF;
alternate-urgent-background: #252428;
alternate-urgent-foreground: #EEE7EF;

selected-active-background: #3C364E;
selected-active-foreground: #EEE7EF;
selected-normal-background: #DED5E0;
selected-normal-foreground: #EEE7EF;
selected-urgent-background: #847890;
selected-urgent-foreground: #EEE7EF;

background-color: #252428;
background: rgba(0,0,0,0.7);
foreground: #DED5E0;
border-color: #3C364E;
}

