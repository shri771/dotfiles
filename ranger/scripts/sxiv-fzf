#!/usr/bin/env bash
set -euo pipefail

dir=${1:-$PWD}

command -v fzf >/dev/null 2>&1 || {
  printf 'fzf is not installed or not in PATH\n' >&2
  exit 127
}

if [[ ! -d "$dir" ]]; then
  dir=$(dirname -- "$dir")
fi

selection=$(
  find "$dir" -maxdepth 1 -type f \
    \( -iname '*.avif' \
    -o -iname '*.bmp' \
    -o -iname '*.gif' \
    -o -iname '*.heic' \
    -o -iname '*.jpeg' \
    -o -iname '*.jpg' \
    -o -iname '*.png' \
    -o -iname '*.tif' \
    -o -iname '*.tiff' \
    -o -iname '*.webp' \) \
    -print0 |
    sort -z |
    fzf --read0 --print0 --height=80% --reverse --border --delimiter=/ --with-nth=-1 \
      --prompt='sxiv> ' \
      --preview='file -- {}; printf "\n"; identify -format "%m  %wx%h  %[colorspace]\n" -- {} 2>/dev/null || true; identify -format "%[size]\n" -- {} 2>/dev/null || true' |
    tr -d '\0'
) || exit 0

if [[ -z "$selection" ]]; then
  exit 0
fi

exec "${HOME}/.config/ranger/scripts/sxiv-current-dir" "$selection"
