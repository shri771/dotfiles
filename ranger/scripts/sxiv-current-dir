#!/usr/bin/env bash
set -euo pipefail

target=${1:-}

command -v sxiv >/dev/null 2>&1 || {
  printf 'sxiv is not installed or not in PATH\n' >&2
  exit 127
}

if [[ -z "$target" ]]; then
  target=$PWD
fi

if [[ -d "$target" ]]; then
  dir=$target
  selected=
else
  dir=$(dirname -- "$target")
  selected=$(basename -- "$target")
fi

mapfile -d '' images < <(
  find "$dir" -maxdepth 1 -type f \
    \( -iname '*.avif' \
    -o -iname '*.bmp' \
    -o -iname '*.gif' \
    -o -iname '*.heic' \
    -o -iname '*.jpeg' \
    -o -iname '*.jpg' \
    -o -iname '*.png' \
    -o -iname '*.tif' \
    -o -iname '*.tiff' \
    -o -iname '*.webp' \) \
    -print0 | sort -z
)

if (( ${#images[@]} == 0 )); then
  exit 0
fi

start=1
if [[ -n "${selected:-}" ]]; then
  for index in "${!images[@]}"; do
    if [[ $(basename -- "${images[$index]}") == "$selected" ]]; then
      start=$((index + 1))
      break
    fi
  done
fi

exec sxiv -a -n "$start" "${images[@]}"
